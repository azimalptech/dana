# Dana — docker-compose environment. Copy to `.env` (same directory as
# docker-compose.yml) and fill in every value below. `.env` is already
# git-ignored (see .gitignore's bare `.env` pattern) — never commit it.
#
#   cp .env.example .env

# ------------------------------------------------------------- database
# MYSQL_ROOT_PASSWORD is only used by the db container's own healthcheck
# and for administrative access (docker compose exec db mysql -uroot -p).
# The api service itself connects as DB_USERNAME, never root.
DB_ROOT_PASSWORD=
DB_DATABASE=dana
DB_USERNAME=dana
DB_PASSWORD=

# ---------------------------------------------------------- credentials
# Two independent 32-byte random secrets. Generate each with:
#   openssl rand -base64 32
#
# APP_CRED_KEY decrypts student passwords for the teacher reveal path
# (FR-1.10). JWT_SECRET signs every access/refresh token.
#
# Generate these ONCE, before the first `docker compose up`, and then
# leave them alone:
#   - changing APP_CRED_KEY makes every already-stored student password
#     permanently unreadable through the reveal path (not lost — the
#     bcrypt login hash is separate and unaffected — just unrecoverable
#     for a teacher to view again).
#   - changing JWT_SECRET signs every logged-in student and teacher out
#     at once.
# Back this .env file up somewhere safe (a password manager, not the
# repo) once these are set.
APP_CRED_KEY=
JWT_SECRET=

# --------------------------------------------------------------- domain
# A real domain you control, with its DNS A record already pointed at
# this server's public IP, gets Caddy to request and auto-renew a
# Let's Encrypt certificate — this is what resolves Q-36 (the app no
# longer talks to the API over plaintext HTTP). Leave unset (or
# "localhost") for a first boot before DNS is ready, or a LAN-only
# deployment — Caddy then serves plain HTTP on :80 only.
SITE_ADDRESS=localhost

# APP_URL is informational only right now (nothing in the API reads it
# yet) — set it to the same value as SITE_ADDRESS with a scheme, e.g.
# https://dana.example.com, so it is correct if that changes.
APP_URL=

# ------------------------------------------------------------- runtime
APP_ENV=production
# Never "true" on a real deployment — APP_DEBUG governs how much detail
# JsonErrorMiddleware puts in an error response body.
APP_DEBUG=false
LOG_LEVEL=info

# ------------------------------------------------------- push (FR-10.3)
# Optional. Unset means announcements stay inbox-only (today's actual
# state — no client caller hits /me/device yet either way).
FCM_SERVER_KEY=

# ------------------------------------------------------------------
# Intentionally NOT here: ANTHROPIC_API_KEY / GEMINI_API_KEY /
# DEEPSEEK_API_KEY / LLM_PROVIDER. Hard invariant #6 (CLAUDE.md): there
# is no AI content generation in this product. docker/entrypoint.sh
# writes those blank into the container's .env regardless of anything
# set here — do not try to wire one back in through this file.
