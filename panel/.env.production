# Built into the bundle by `vite build` (FR-15.24).
#
# The panel is served from admin.mydana.app and the API from
# api.mydana.app, so a relative /api/v1 would resolve against the panel's
# own host, which serves no API. The origin has to be named here.
#
# The API must allowlist this panel's origin in CORS_ALLOWED_ORIGINS, or
# every request fails in the browser with an opaque CORS error and
# nothing in the API log. The two settings are a pair.
VITE_API_BASE=https://api.mydana.app/api/v1
