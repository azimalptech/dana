<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch window. Brand maroon, matching the Figma
     `splash-screen` frame and the Flutter SplashScreen widget that
     replaces it — so the handover is invisible instead of a white flash.
     The wordmark itself is drawn by Flutter, not bitmapped here, so it
     stays crisp at every density. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/dana_brand" />
</layer-list>
