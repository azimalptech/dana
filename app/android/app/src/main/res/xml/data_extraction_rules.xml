<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules. Session tokens live in the app's
     SharedPreferences; excluding shared_prefs keeps a working session out
     of cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
