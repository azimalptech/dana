<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds talk to the dev API over plain HTTP on the LAN
         (Android exempts only loopback by default). Scoped to this
         debug manifest so a release build stays cleartext-free — the
         production API must be HTTPS (Q-36). -->
    <application
        android:usesCleartextTraffic="true"
        tools:ignore="HardcodedDebugMode" />
</manifest>
