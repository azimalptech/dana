# Dana API — copy to .env and fill in. NEVER commit .env.
# NFR-4: nothing in the code may assume localhost; it all comes from here.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/dana/api
# FR-8.10: streak day boundary is evaluated in this zone, server-side,
# never from the device clock.
APP_TIMEZONE=Asia/Ashgabat

# ------------------------------------------------------------ database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dana
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------- credentials
# 32 random bytes, base64. Generate with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
#
# This key decrypts student passwords for the teacher reveal (FR-1.10).
# It MUST NOT be committed, and MUST NOT be included in a database
# backup — that separation is what makes a stolen SQL dump useless.
APP_CRED_KEY=

JWT_SECRET=
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=2592000     # 30 days

# -------------------------------------------------------------- logging
# One rotating file per channel: app, auth, worker.
# Never contains passwords or tokens — identifiers and outcomes only.
LOG_PATH=../storage/logs
LOG_LEVEL=info
LOG_MAX_FILES=30

# --------------------------------------------------------------- files
# FR-3.11: 500 MB per file, stored OUTSIDE the web root.
STORAGE_PATH=../storage
MAX_UPLOAD_BYTES=524288000

# ------------------------------------------------- LLM providers (FR-4.18)
# All empty deliberately. Generation is DISABLED until one is supplied,
# and the queue rejects a run up front rather than failing mid-way.
#
# NOTE: a Claude.ai Pro/Max subscription is NOT usable here. It
# authenticates you in Claude apps, not a third-party server. This needs
# an API key from console.anthropic.com, billed separately.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_GENERATE=claude-opus-5
ANTHROPIC_MODEL_JUDGE=claude-sonnet-5

# Adapters exist but stay dormant until a key appears.
GEMINI_API_KEY=
GEMINI_MODEL_GENERATE=gemini-3.5-flash
GEMINI_MODEL_JUDGE=gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# ----------------------------------------------------- push (FR-10.3)
# Primary delivery channel; the in-app inbox works regardless.
#
# FCM HTTP v1 needs a Firebase SERVICE ACCOUNT key (the legacy server key
# was retired in 2024). Firebase console -> Project settings -> Service
# accounts -> Generate new private key, save the JSON OUTSIDE the web
# root and point this at it. APNs is delivered through FCM, so one file
# covers Android and iOS.
FCM_SERVICE_ACCOUNT_PATH=
