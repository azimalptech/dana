# Dana API — copy to .env and fill in. NEVER commit .env.
# NFR-4: nothing in the code may assume localhost; it all comes from here.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/dana/api
# Origins allowed to call this API from a browser (FR-15.24).
# Comma-separated, exact match, scheme included, no trailing slash.
# The admin panel needs this ONLY when it is served from a different
# host than the API - e.g. admin.mydana.app calling api.mydana.app.
# Leave EMPTY for a single-origin deployment: the API then sends no
# CORS headers at all, exactly as it did before this setting existed.
# Never use "*" - replies carry per-student data and, on the FR-1.10
# reveal path, a decrypted credential.
CORS_ALLOWED_ORIGINS=https://admin.mydana.app

# FR-8.10: streak day boundary is evaluated in this zone, server-side,
# never from the device clock.
APP_TIMEZONE=Asia/Ashgabat

# ------------------------------------------------------------ database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dana
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------- credentials
# 32 random bytes, base64. Generate with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
#
# This key decrypts student passwords for the teacher reveal (FR-1.10).
# It MUST NOT be committed, and MUST NOT be included in a database
# backup — that separation is what makes a stolen SQL dump useless.
APP_CRED_KEY=

JWT_SECRET=
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=2592000     # 30 days
# Grace for a just-rotated refresh token: a retry after a lost response,
# or a second browser tab, must not be read as a stolen token (FR-15.15).
JWT_REFRESH_GRACE=60        # 1 minute

# -------------------------------------------------------------- logging
# One rotating file per channel: app, auth, worker.
# Never contains passwords or tokens — identifiers and outcomes only.
LOG_PATH=../storage/logs
LOG_LEVEL=info
LOG_MAX_FILES=30

# --------------------------------------------------------------- files
# FR-3.11: 500 MB per file, stored OUTSIDE the web root.
STORAGE_PATH=../storage
MAX_UPLOAD_BYTES=524288000

# ------------------------------------------------- LLM providers (FR-4.18)
# All empty deliberately. Generation is DISABLED until one is supplied,
# and the queue rejects a run up front rather than failing mid-way.
#
# NOTE: a Claude.ai Pro/Max subscription is NOT usable here. It
# authenticates you in Claude apps, not a third-party server. This needs
# an API key from console.anthropic.com, billed separately.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_GENERATE=claude-opus-5
ANTHROPIC_MODEL_JUDGE=claude-sonnet-5

# Adapters exist but stay dormant until a key appears.
GEMINI_API_KEY=
GEMINI_MODEL_GENERATE=gemini-3.5-flash
GEMINI_MODEL_JUDGE=gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# --------------------------------- media generation (FR-15.18)
# SEPARATE from the block above, and a different thing. Nothing here
# writes a question, an option or an answer. It renders text the
# superadmin ALREADY authored — a payload part's `audio_note`
# ("seven") or `image_note` ("italy") — as an mp3 or a png, so the
# recording and the illustrating do not have to be done by hand.
#
# Blank by default and blank is a working install: with no key the
# routes answer "not configured" and the panel shows no generate
# buttons. Fill it in only on the machine that does the authoring;
# the key never belongs in the repository, the panel bundle or the
# phone app.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Two voices: a scene like "Receptionist: … / Guest: …" is performed by
# both. Which role gets which voice is fixed by sorting the two names,
# so a teacher sounds the same whether they speak first or second.
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_VOICE_B=Puck
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 16:9 because the app is landscape: a stem image is drawn 160px tall
# across the full width and an option tile 96px tall, both with cover
# cropping — a square source loses its top and bottom in both places.
GEMINI_IMAGE_ASPECT=16:9
GEMINI_IMAGE_SIZE=1K
# The live API rejects image/png on this model (400, "Supported
# values: image/jpeg"), whatever the docs example shows.
GEMINI_IMAGE_MIME=image/jpeg
GEMINI_TIMEOUT=120
# The wording around the note. There is no accent or determinism
# parameter in the API, so this string is the only thing keeping two
# clips authored months apart consistent — change it deliberately.
# {text} is replaced with the note. Defaults live in GeminiMedia.
GEMINI_TTS_DIRECTIVE=
# {a} and {b} are the two speaker names, {script} the transcript.
GEMINI_DIALOGUE_DIRECTIVE=
GEMINI_IMAGE_DIRECTIVE=

# ----------------------------------------------------- push (FR-10.3)
# Primary delivery channel; the in-app inbox works regardless.
#
# FCM HTTP v1 needs a Firebase SERVICE ACCOUNT key (the legacy server key
# was retired in 2024). Firebase console -> Project settings -> Service
# accounts -> Generate new private key, save the JSON OUTSIDE the web
# root and point this at it. APNs is delivered through FCM, so one file
# covers Android and iOS.
FCM_SERVICE_ACCOUNT_PATH=
