{
    "name": "dana/api",
    "description": "Dana English learning centre — REST API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "firebase/php-jwt": "^7.1",
        "illuminate/database": "^10.0",
        "monolog/monolog": "^3.5",
        "php-di/php-di": "^7.0",
        "respect/validation": "^2.3",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "smalot/pdfparser": "^2.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Dana\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dana\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S 0.0.0.0:8081 -t public public/index.php",
        "migrate": "php bin/migrate.php",
        "seed-superadmin": "php bin/seed_superadmin.php",
        "worker": "php bin/worker.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
